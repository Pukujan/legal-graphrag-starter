    },
    "/api/v1/cases/{doc_id}": {
      "get": {
        "operationId": "case_api_v1_cases__doc_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "doc_id",
            "required": true,
            "schema": {
              "title": "Doc Id",
