{
  "components": {
    "schemas": {
      "CheckClaim": {
        "additionalProperties": false,
        "properties": {
          "chunk_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunk Id"
          },
          "citation": {
            "default": "",
            "title": "Citation",
            "type": "string"
          },
          "cited_text": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Cited Text",
            "type": "string"
          },
          "text": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "cited_text"
        ],
        "title": "CheckClaim",
        "type": "object"
      },
      "CheckRequest": {
        "additionalProperties": false,
        "properties": {
          "claims": {
            "items": {
              "$ref": "#/components/schemas/CheckClaim"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Claims",
            "type": "array"
          },
          "scorer": {
            "default": "minicheck",
            "enum": [
              "minicheck",
              "hhem",
              "jev"
            ],
            "title": "Scorer",
            "type": "string"
          },
          "temperature": {
            "default": 1.0,
            "exclusiveMinimum": 0.0,
            "maximum": 20.0,
            "title": "Temperature",
            "type": "number"
          },
          "threshold": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Threshold",
            "type": "number"
          }
        },
        "required": [
          "claims"
        ],
        "title": "CheckRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NeighborhoodRequest": {
        "additionalProperties": false,
        "properties": {
          "depth": {
            "default": 1,
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Depth",
            "type": "integer"
          },
          "direction": {
            "default": "incoming",
            "enum": [
              "incoming",
              "outgoing",
              "both"
            ],
            "title": "Direction",
            "type": "string"
          },
          "edge_kinds": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Edge Kinds",
            "type": "array"
          },
          "max_edges": {
            "default": 1000,
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Max Edges",
            "type": "integer"
          },
          "max_nodes": {
            "default": 500,
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Max Nodes",
            "type": "integer"
          },
          "max_scanned_edges": {
            "default": 10000,
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Max Scanned Edges",
            "type": "integer"
          },
          "seeds": {
            "items": {
              "type": "string"
            },
            "title": "Seeds",
            "type": "array"
          }
        },
        "required": [
          "seeds"
        ],
        "title": "NeighborhoodRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Local research prototype API for bounded citation graph browsing. Search is metadata substring matching, not semantic legal retrieval.",
    "title": "Legal Graph API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/authority": {
      "get": {
        "operationId": "authority_api_v1_authority_get",
        "parameters": [
          {
            "in": "query",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Authority"
      }
    },
